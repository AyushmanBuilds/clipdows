{
  "name": "clipdows",
  "productName": "ClipDows",
  "version": "0.1.0",
  "description": "Copy Anywhere. Access Everywhere. A cross-device clipboard manager for Windows.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always"
  },
  "author": "Ayushmanbuilds",
  "license": "UNLICENSED",
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "active-win": "^8.2.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "tesseract.js": "^7.0.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ayushmanbuilds.clipdows",
    "productName": "ClipDows",
    "copyright": "Copyright \u00a9 2026 Ayushmanbuilds",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "assets/tessdata/**",
      "node_modules/@nut-tree-fork/**",
      "node_modules/active-win/**",
      "node_modules/uiohook-napi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ClipDows-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClipDows"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AyushmanBuilds",
        "repo": "clipdows",
        "releaseType": "draft"
      }
    ],
    "npmRebuild": false
  }
}
